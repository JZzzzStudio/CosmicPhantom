{
  "servers": {
    "cosmic-phantom": {
      "type": "stdio",
      "command": "<CP_ROOT>//tools//node//node.exe",
      "args": [
        "<CP_ROOT>//resources//mcp-server//index.js",
        "--root",
        "<CP_ROOT>"
      ],
      "env": {
        "CP_ROOT": "<CP_ROOT>"
      },
      "enabled": true,
      "timeout": 30
    }
  }
}
