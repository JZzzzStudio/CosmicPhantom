{
  "mcpServers": {
    "ScraplingServer": {
      "command": "<USER_HOME>/AppData/Local/Programs/Python/Python312/Scripts/scrapling.exe",
      "args": ["mcp"]
    },
    "cosmic-phantom": {
      "type": "stdio",
      "command": "<USER_HOME>/.cosmic-phantom/tools/node/node.exe",
      "args": ["<USER_HOME>/.cosmic-phantom/resources/mcp-server/index.js", "--root", "<USER_HOME>/.cosmic-phantom"],
      "env": {
        "CP_ROOT": "<USER_HOME>/.cosmic-phantom"
      }
    }
  }
}
